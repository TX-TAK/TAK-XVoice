<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Texas TAK brand kit tokens (tokens/tokens.json), verbatim. These
         are the source of truth; the semantic xv_* names below alias
         them so layouts and code never hard-code a hex.

         Colour semantics (kept quiet on purpose, one meaning per hue):
           Honey      = voice activity: someone is talking, the active
                        slot, the brand accent.
           Bluebonnet = system / network: connected, server, mesh legs.
           Texas Red  = you are transmitting.
         Errors (e.g. a mesh leg in the clear) use xv_err: a brighter red
         than Texas Red, because Texas Red as 11-12sp text on Hive Black
         falls below a readable contrast ratio. -->
    <color name="xv_brand_hive_black">#050608</color>
    <color name="xv_brand_comb">#0F1318</color>
    <color name="xv_brand_line">#1A2028</color>
    <color name="xv_brand_line_strong">#232A33</color>
    <color name="xv_brand_signal_grey">#8A96A3</color>
    <color name="xv_brand_wax_white">#F4F1EA</color>
    <color name="xv_brand_honey">#E8A33D</color>
    <color name="xv_brand_honey_tint">#1FE8A33D</color>
    <color name="xv_brand_bluebonnet">#5B7FE8</color>
    <color name="xv_brand_texas_blue">#002868</color>
    <color name="xv_brand_texas_red">#BF0A30</color>

    <!-- Semantic aliases used across layouts and code. -->
    <color name="xv_bg">@color/xv_brand_hive_black</color>
    <color name="xv_surface">@color/xv_brand_comb</color>
    <color name="xv_surface_alt">@color/xv_brand_line</color>
    <color name="xv_line">@color/xv_brand_line</color>
    <color name="xv_line_strong">@color/xv_brand_line_strong</color>
    <color name="xv_text">@color/xv_brand_wax_white</color>
    <color name="xv_text_dim">@color/xv_brand_signal_grey</color>
    <color name="xv_accent">@color/xv_brand_honey</color>
    <color name="xv_accent_hover">#C98A12</color>
    <!-- Voice activity (talker name, signal glyph, slot badges). -->
    <color name="xv_voice">@color/xv_brand_honey</color>
    <!-- System / network state (status dot, server, mesh line). -->
    <color name="xv_net">@color/xv_brand_bluebonnet</color>
    <color name="xv_ok">@color/xv_brand_bluebonnet</color>
    <color name="xv_warn">@color/xv_brand_honey</color>
    <color name="xv_err">#FF5252</color>
    <!-- Server leg glyph: network, so Bluebonnet. -->
    <color name="xv_cloud">@color/xv_brand_bluebonnet</color>
    <color name="xv_ptt_idle">@color/xv_brand_honey</color>
    <color name="xv_ptt_active">@color/xv_brand_texas_red</color>
</resources>
