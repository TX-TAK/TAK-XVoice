<?xml version="1.0" encoding="utf-8"?>
<!--
  XV Settings. Four tabs — Devices | TX/RX | Server | Mesh — over one
  scrolling body; XvDropDownReceiver.wireSettingsTabs shows one section
  at a time. Everything uses the shared style system (values/styles.xml):
  cards and switch rows on Comb, section headers in tracked Signal Grey,
  48dp touch targets, Honey for voice/brand, Bluebonnet for system state.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_bg"
    android:orientation="vertical">

    <!-- Header: back + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/xv_settings_back"
            style="@style/XV.BackButton" />

        <TextView
            style="@style/XV.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Settings" />
    </LinearLayout>

    <!-- Tab strip. Order matches wireSettingsTabs. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/xv_tab_devices"
            style="@style/XV.Tab"
            android:text="Devices" />

        <Button
            android:id="@+id/xv_tab_txrx"
            style="@style/XV.Tab"
            android:text="TX/RX" />

        <Button
            android:id="@+id/xv_tab_server"
            style="@style/XV.Tab"
            android:text="Server" />

        <Button
            android:id="@+id/xv_tab_mesh"
            style="@style/XV.Tab"
            android:text="Mesh" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ============================================================
                 Devices: one card per input, with a read-only button map.
                 PTT1 → channel 1, PTT2 → channel 2 (channel 1 when 2 is
                 off) is fixed; Swap in the channel list is the only way to
                 invert it. The spinners inside the cards are the "Change"
                 control (ids unchanged for wireAinaPicker /
                 wireExternalButtonPicker). The NEEDS RE-PAIR chips are
                 placeholders, GONE until the service reports a device
                 that must be re-paired.
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/xv_section_devices"
                style="@style/XV.Page">

                <!-- Shown only while the Bluetooth adapter is off; tap opens
                     system BT settings (wireBtOffBanner). -->
                <TextView
                    android:id="@+id/xv_devices_bt_off_banner"
                    style="@style/XV.Card"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="48dp"
                    android:text="Bluetooth is off — tap to turn it on"
                    android:textColor="@color/xv_net"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/XV.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What keys the radio, and on which channel." />

                <!-- Card: speaker-mic (audio + buttons) -->
                <LinearLayout style="@style/XV.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_xv_radio" />

                        <TextView
                            style="@style/XV.Text.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Speaker-mic" />

                        <TextView
                            android:id="@+id/xv_chip_aina_repair"
                            style="@style/XV.Chip.Alert"
                            android:text="NEEDS RE-PAIR"
                            android:visibility="gone" />

                        <TextView
                            style="@style/XV.Chip"
                            android:text="AUDIO + PTT" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/xv_spinner_aina"
                        style="@style/XV.Spinner"
                        android:contentDescription="Speaker-mic device" />

                    <TextView
                        android:id="@+id/xv_label_aina_status"
                        style="@style/XV.Text.Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="—" />

                    <TextView
                        style="@style/XV.Text.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/xv_button_map_speaker_mic" />
                </LinearLayout>

                <!-- Card: button-only PTT (puck, handlebar, glove) -->
                <LinearLayout style="@style/XV.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/XV.Text.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PTT button" />

                        <TextView
                            android:id="@+id/xv_chip_button_repair"
                            style="@style/XV.Chip.Alert"
                            android:text="NEEDS RE-PAIR"
                            android:visibility="gone" />

                        <TextView
                            style="@style/XV.Chip"
                            android:text="BUTTON ONLY" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/xv_spinner_aina_secondary"
                        style="@style/XV.Spinner"
                        android:contentDescription="PTT button device" />

                    <TextView
                        android:id="@+id/xv_label_aina_secondary_status"
                        style="@style/XV.Text.Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="—" />

                    <!-- Shown only when the assigned button is paired in
                         Android Bluetooth Settings (OS-bonded), which causes
                         GATT pairing loops (wireExternalButtonPicker). -->
                    <Button
                        android:id="@+id/xv_btn_fix_bonded_button"
                        style="@style/XV.Button.Danger"
                        android:text="⚠ Fix this button — remove it from Android Bluetooth"
                        android:visibility="gone" />

                    <TextView
                        style="@style/XV.Text.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/xv_button_map_button" />
                </LinearLayout>

                <!-- Card: Samsung Active key. Visible only on Samsung
                     hardware with the programmable key
                     (wireSamsungActiveKeyRow). Samsung's own setting is the
                     on/off switch; tapping the card opens it. -->
                <LinearLayout
                    android:id="@+id/xv_row_samsung_active_key"
                    style="@style/XV.Row"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <TextView
                        style="@style/XV.Row.Label"
                        android:text="Phone Active key"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/xv_label_samsung_active_key_status"
                        style="@style/XV.Chip.Net"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/xv_label_samsung_active_key_help"
                    style="@style/XV.CaptionBlock"
                    android:text="Active key  →  channel 1. Tap to open Samsung's Active button settings, turn on &quot;Use Active button with app&quot; and pick TAK-XVoice. Works in the foreground, in the background and with the screen locked. Turn it off there to give the key back to Samsung."
                    android:visibility="gone" />

                <!-- Add a BLE PTT button that doesn't pair via Android
                     Bluetooth (vendor-service pucks): the scan dialog. -->
                <Button
                    android:id="@+id/xv_btn_scan_ble_ptt"
                    style="@style/XV.Button.Pill"
                    android:layout_marginTop="12dp"
                    android:text="+  Add a PTT button (handlebar, glove, puck)" />

                <!-- Audio device -->
                <TextView
                    style="@style/XV.SectionHeader"
                    android:text="Audio device" />

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="Where you hear and speak. Auto follows the speaker-mic when it has audio, otherwise the built-in route below. Pick a Bluetooth device to split: PTT from the speaker-mic, audio through a car or headphones." />

                <Spinner
                    android:id="@+id/xv_spinner_bt_audio_override"
                    style="@style/XV.Spinner"
                    android:contentDescription="Audio device" />

                <TextView
                    style="@style/XV.SectionHeader"
                    android:layout_marginTop="16dp"
                    android:text="Built-in fallback (no Bluetooth)" />

                <Spinner
                    android:id="@+id/xv_spinner_route"
                    style="@style/XV.Spinner"
                    android:contentDescription="Built-in audio route" />

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="Used when Audio device is Auto and no Bluetooth or wired headset is connected: phone speaker for hands-free, earpiece for hold-to-ear." />

                <!-- Troubleshooting: collapsed by default; the header
                     toggles xv_devices_troubleshoot. -->
                <TextView
                    android:id="@+id/xv_devices_troubleshoot_toggle"
                    style="@style/XV.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Troubleshooting  ▸"
                    android:textColor="@color/xv_text_dim" />

                <LinearLayout
                    android:id="@+id/xv_devices_troubleshoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/XV.Text.Warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Don't pair Bluetooth PTT buttons in Android Bluetooth Settings — it causes pairing loops. Add them with the button above. If you see loops, Forget the button in Android Settings." />

                    <Button
                        android:id="@+id/xv_btn_remove_ble_ptt"
                        style="@style/XV.Button"
                        android:text="Forget an added PTT button" />

                    <LinearLayout style="@style/XV.Row">

                        <TextView
                            android:id="@+id/xv_label_auto_connect_bt"
                            style="@style/XV.Row.Label"
                            android:labelFor="@+id/xv_switch_auto_connect_bt"
                            android:text="Auto-connect compatible Bluetooth" />

                        <Switch
                            android:id="@+id/xv_switch_auto_connect_bt"
                            style="@style/XV.Switch" />
                    </LinearLayout>

                    <TextView
                        style="@style/XV.CaptionBlock"
                        android:text="When on, XV connects the first compatible paired speaker-mic or BLE PTT button it finds on launch. Turn off to control connections from the cards above." />
                </LinearLayout>

                <!-- Help & Documentation: opens the public docs site
                     (xv_help_url) via ACTION_VIEW (wireSettings). -->
                <TextView
                    style="@style/XV.SectionHeader"
                    android:text="Help" />

                <Button
                    android:id="@+id/xv_btn_help_docs"
                    style="@style/XV.Button"
                    android:text="@string/xv_help_label" />

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="@string/xv_help_caption" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>

            <!-- ============================================================
                 TX/RX: layout (left-handed, map PTT), hot mic, PTT timeout,
                 talk-permit tone.
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/xv_section_txrx"
                style="@style/XV.Page"
                android:visibility="gone">

                <!-- Latched mode is hidden by design (wired, never shown). -->
                <Switch
                    android:id="@+id/xv_switch_latched"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    style="@style/XV.SectionHeader"
                    android:layout_marginTop="0dp"
                    android:text="Layout" />

                <!-- Left-handed: moves each PTT to the start of its row and
                     docks the map PTT buttons on the left. Display only;
                     the PTT → channel mapping is unchanged. -->
                <LinearLayout style="@style/XV.Row">

                    <TextView
                        android:id="@+id/xv_label_ptt_left"
                        style="@style/XV.Row.Label"
                        android:labelFor="@+id/xv_switch_ptt_left"
                        android:text="Left-handed (PTT on the left)" />

                    <Switch
                        android:id="@+id/xv_switch_ptt_left"
                        style="@style/XV.Switch" />
                </LinearLayout>

                <!-- Map PTT buttons (map HUD). On by default. -->
                <LinearLayout style="@style/XV.Row">

                    <TextView
                        android:id="@+id/xv_label_map_ptt"
                        style="@style/XV.Row.Label"
                        android:labelFor="@+id/xv_switch_map_ptt"
                        android:text="PTT buttons on the map" />

                    <Switch
                        android:id="@+id/xv_switch_map_ptt"
                        style="@style/XV.Switch" />
                </LinearLayout>

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="Hex PTT buttons on the map edge while the XV panel is closed. Button 1 keys channel 1, button 2 keys channel 2. Size scales with the screen." />

                <RadioGroup
                    android:id="@+id/xv_map_ptt_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Map PTT button size"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/xv_map_ptt_size_s"
                        style="@style/XV.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Small" />

                    <RadioButton
                        android:id="@+id/xv_map_ptt_size_m"
                        style="@style/XV.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Medium" />

                    <RadioButton
                        android:id="@+id/xv_map_ptt_size_l"
                        style="@style/XV.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Large" />
                </RadioGroup>

                <TextView
                    style="@style/XV.SectionHeader"
                    android:text="Hot mic (PTT latency)" />

                <LinearLayout style="@style/XV.Row">

                    <TextView
                        android:id="@+id/xv_label_hot_mic"
                        style="@style/XV.Row.Label"
                        android:labelFor="@+id/xv_switch_hot_mic"
                        android:text="Hot mic mode (instant PTT)" />

                    <Switch
                        android:id="@+id/xv_switch_hot_mic"
                        style="@style/XV.Switch" />
                </LinearLayout>

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="Keeps the Bluetooth audio link warm while you're in a channel, so the first PTT after a long pause skips the 0.5–1.5 s start-up. Trade-off: music and podcasts stay paused for the whole session, not just while you talk." />

                <TextView
                    style="@style/XV.SectionHeader"
                    android:text="PTT timeout" />

                <TextView
                    android:id="@+id/xv_label_ptt_timeout"
                    style="@style/XV.Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="30 s" />

                <SeekBar
                    android:id="@+id/xv_slider_ptt_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="PTT timeout"
                    android:max="90"
                    android:min="20"
                    android:progress="30" />

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="Releases a stuck PTT after this many seconds (20–90 s)." />

                <!-- Latched timeout: hidden alongside the latched switch. -->
                <SeekBar
                    android:id="@+id/xv_slider_latched_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/xv_label_latched_timeout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    style="@style/XV.SectionHeader"
                    android:text="Talk permit tone" />

                <Spinner
                    android:id="@+id/xv_spinner_tpt"
                    style="@style/XV.Spinner"
                    android:contentDescription="Talk permit tone" />

                <Button
                    android:id="@+id/xv_btn_test_tpt"
                    style="@style/XV.Button"
                    android:text="Play test tone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>

            <!-- ============================================================
                 Server: TAK server, voice connection, mission auto-channels.
                 Channel choice lives on the main panel / channel list.
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/xv_section_server"
                style="@style/XV.Page"
                android:visibility="gone">

                <TextView
                    style="@style/XV.SectionHeader"
                    android:layout_marginTop="0dp"
                    android:text="TAK server" />

                <!-- Tappable: opens the server picker (showTakServerPicker). -->
                <TextView
                    android:id="@+id/xv_tak_server_label"
                    style="@style/XV.Card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:minHeight="48dp"
                    android:text="—"
                    android:textColor="@color/xv_net"
                    android:textSize="14sp" />

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="Voice connects to the same host as your TAK server. Tap to choose when several are enrolled." />

                <TextView
                    style="@style/XV.SectionHeader"
                    android:text="Voice connection" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/xv_btn_mumble_connect"
                        style="@style/XV.Button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Connect" />

                    <Button
                        android:id="@+id/xv_btn_mumble_disconnect"
                        style="@style/XV.Button"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Disconnect" />
                </LinearLayout>

                <!-- Mission auto-channels: server-side behaviour (the mission
                     channel is created / joined on the voice server). -->
                <TextView
                    style="@style/XV.SectionHeader"
                    android:text="Missions" />

                <LinearLayout style="@style/XV.Row">

                    <TextView
                        android:id="@+id/xv_label_mission_channels"
                        style="@style/XV.Row.Label"
                        android:labelFor="@+id/xv_switch_mission_channels"
                        android:text="Mission auto-channels" />

                    <Switch
                        android:id="@+id/xv_switch_mission_channels"
                        style="@style/XV.Switch" />
                </LinearLayout>

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="Your active ATAK Data Sync mission drives channel 1: XV derives the channel name from the mission and joins it, so the whole mission team lands on one voice channel with no manual coordination." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>

            <!-- ============================================================
                 Mesh (approved mesh settings mockup):
                   1. One master switch + live status.
                   2. Channels as a single-column list (cards built in
                      refreshMeshSection): name, badges, and Off / Backup /
                      Both per channel. Tap for details, long-press to
                      forget an offline channel. "+ Add channel" opens the
                      presets; sharing sits with the list.
                   3. Interop patch (device-local) and Security & recovery
                      collapsed out of the everyday path.
                 The mesh leg is always encrypted: no policy choice here.
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/xv_section_mesh"
                style="@style/XV.Page"
                android:visibility="gone">

                <!-- 1. Master switch + status -->
                <LinearLayout
                    style="@style/XV.Card"
                    android:layout_marginTop="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/xv_label_mesh_voice"
                            style="@style/XV.Row.Label"
                            android:labelFor="@+id/xv_switch_mesh_voice"
                            android:text="Mesh voice"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/xv_switch_mesh_voice"
                            style="@style/XV.Switch" />
                    </LinearLayout>

                    <TextView
                        style="@style/XV.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Keeps voice working when the server is down. Wi-Fi and mesh networks only, never cellular. Always encrypted." />
                </LinearLayout>

                <TextView
                    android:id="@+id/xv_settings_mesh_status"
                    style="@style/XV.Text.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:text="Mesh voice is off" />

                <!-- 2. Channels -->
                <TextView
                    style="@style/XV.SectionHeader"
                    android:layout_marginTop="16dp"
                    android:text="Channels" />

                <TextView
                    style="@style/XV.CaptionBlock"
                    android:text="Off = no mesh leg. Backup = mesh carries the channel only when the server is down. Both = transmit on server and mesh every time (no gap, more radio traffic)." />

                <LinearLayout
                    android:id="@+id/xv_mesh_channel_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/xv_btn_mesh_add"
                    style="@style/XV.Button.Pill"
                    android:layout_marginTop="10dp"
                    android:text="+  Add channel" />

                <!-- Add-channel presets (toggled by xv_btn_mesh_add). -->
                <LinearLayout
                    android:id="@+id/xv_mesh_add_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/xv_btn_mesh_provision"
                        style="@style/XV.Card"
                        android:background="@drawable/xv_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="56dp">

                        <TextView
                            style="@style/XV.Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Private channel" />

                        <TextView
                            style="@style/XV.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Encrypted. XV picks the name, group and key — nothing to type." />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/xv_btn_mesh_import"
                        style="@style/XV.Card"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="56dp">

                        <TextView
                            style="@style/XV.Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Join a channel plan" />

                        <TextView
                            style="@style/XV.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Import a plan a teammate shared with you." />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/xv_btn_mesh_configure"
                        style="@style/XV.Card"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="56dp">

                        <TextView
                            style="@style/XV.Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom address / interop" />

                        <TextView
                            style="@style/XV.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="For other systems: enter the group address and port yourself." />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/xv_btn_mesh_share"
                    style="@style/XV.Button"
                    android:text="Share channel plan…" />

                <!-- 3a. Interop patch: device-local OpenMANET / VX bridge for
                     the current channel. Collapsed by default. -->
                <TextView
                    android:id="@+id/xv_mesh_patch_toggle"
                    style="@style/XV.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Interop patch (this device)  ▸"
                    android:textColor="@color/xv_text_dim" />

                <LinearLayout
                    android:id="@+id/xv_mesh_patch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/XV.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bridge the current channel to an OpenMANET or VX group. This setting stays on this device and is never shared. Interop traffic is unencrypted." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/xv_edit_patch_group"
                            style="@style/XV.Field"
                            android:layout_width="0dp"
                            android:layout_weight="2"
                            android:hint="Group IP"
                            android:inputType="text" />

                        <EditText
                            android:id="@+id/xv_edit_patch_port"
                            style="@style/XV.Field"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="Port"
                            android:inputType="number" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/xv_btn_patch_save"
                        style="@style/XV.Button"
                        android:text="Apply patch to current channel" />
                </LinearLayout>

                <!-- 3b. Security & recovery: keys, forget, wipe. Collapsed. -->
                <TextView
                    style="@style/XV.SectionHeader"
                    android:text="Security &amp; recovery" />

                <TextView
                    android:id="@+id/xv_mesh_security_toggle"
                    style="@style/XV.Row"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Keys, forget, wipe  ▸"
                    android:textColor="@color/xv_text"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/xv_mesh_security"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/xv_btn_mesh_rotate_key"
                        style="@style/XV.Button"
                        android:text="Rotate the active channel's key…" />

                    <TextView
                        style="@style/XV.CaptionBlock"
                        android:text="Everyone still trusted is re-keyed automatically; guests you shared the old key with are cut off. Use after sharing a key in the field, or if a device or passphrase may be exposed." />

                    <Button
                        android:id="@+id/xv_btn_mesh_forget_all"
                        style="@style/XV.Button"
                        android:text="Forget all offline channels…" />

                    <Button
                        android:id="@+id/xv_btn_mesh_wipe"
                        style="@style/XV.Button.Danger"
                        android:layout_marginTop="16dp"
                        android:text="Wipe mesh keys…" />

                    <TextView
                        style="@style/XV.CaptionBlock"
                        android:text="Erases every mesh channel key and setting from this device. Use if the device may be lost or compromised. Can't be undone." />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
