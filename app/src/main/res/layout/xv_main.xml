<?xml version="1.0" encoding="utf-8"?>
<!--
  Main XV control panel — compact operational view (approved UX v2).

  One row per channel: [hex slot badge] [name + who's talking] [👥 N] [PTT].
  The PTT is large (about half the row, 72dp tall) so it's easy to find
  with a gloved thumb; a left-handed setting moves it to the row start.
    - Channel 1 is never blank while XV is in use; channel 2 is optional.
    - Speaker-mic PTT1 always keys channel 1, PTT2 always keys channel 2
      (both key channel 1 when channel 2 is off). The mapping is fixed;
      swapping channels happens in the channel list, never here.
    - No Swap and no Members button on this screen. Tapping a row's name
      opens the unified channel list; the small "👥 N" count opens that
      channel's member list.
    - With channel 2 off, its row is replaced by "+ Add channel 2".

  Colour semantics (Texas TAK brand kit, kept quiet; no wildlife on the
  PTT screen): Honey = voice activity, Bluebonnet = system / network,
  Texas Red = you are transmitting.

  No ScrollView — the panel must fit a Surface Duo half (~720×1800 px in
  book mode) without scrolling.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- In-call escape bar. visibility=gone until Controller.isInCall()
         is true; refreshMain flips it visible. Always-on-screen Hang Up
         affordance so the operator can never be stranded if the system
         CallStyle notification doesn't render. -->
    <LinearLayout
        android:id="@+id/xv_in_call_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/xv_button_bg_transmitting"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/xv_in_call_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="● IN CALL"
            android:textColor="@color/xv_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/xv_btn_end_call"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/xv_button_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="End Call"
            android:textAllCaps="false"
            android:textColor="@color/xv_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Title bar: quiet brand mark + tracked wordmark + Settings. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/xv_cd_brand_mark"
            android:importantForAccessibility="no"
            android:src="@drawable/xv_tool_icon"
            android:tint="@color/xv_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.3"
            android:text="XVOICE"
            android:textColor="@color/xv_text"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/xv_btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/xv_button_bg"
            android:contentDescription="@string/xv_cd_settings"
            android:src="@drawable/ic_xv_settings"
            android:tint="@color/xv_text_dim" />
    </LinearLayout>

    <!-- One status line: connection dot · server · audio route. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <View
            android:id="@+id/xv_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/xv_dot" />

        <TextView
            android:id="@+id/xv_server_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="not connected"
            android:textColor="@color/xv_net"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/xv_audio_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:paddingStart="8dp"
            android:singleLine="true"
            android:text="Auto"
            android:textColor="@color/xv_net"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Channel 1 row. Option B sizing: tall row with a large PTT
         (about half the row) beside the name; the 👥 count is its own
         48dp target, not nested in the tappable name area. Left-handed
         mode moves the PTT to the start of the row at inflate. -->
    <LinearLayout
        android:id="@+id/xv_ptt_card_1"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/xv_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/xv_slot_badge_1"
            android:layout_width="24dp"
            android:layout_height="27dp"
            android:background="@drawable/xv_hex_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="1"
            android:textColor="@color/xv_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tap the name area → unified channel list. -->
        <LinearLayout
            android:id="@+id/xv_ptt_header_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="48dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/xv_ptt_channel_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:textColor="@color/xv_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Alpha  ▾" />

            <TextView
                android:id="@+id/xv_ptt_activity_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/xv_text_dim"
                android:textSize="12sp"
                tools:text="quiet" />
        </LinearLayout>

        <TextView
            android:id="@+id/xv_members_1"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/xv_text_dim"
            android:textSize="12sp"
            tools:text="👥 4" />

        <Button
            android:id="@+id/xv_btn_ptt"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.9"
            android:background="@drawable/xv_ptt_bg"
            android:letterSpacing="0.2"
            android:text="PTT"
            android:textColor="@color/xv_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Channel 2 row. Option B sizing: tall row with a large PTT
         (about half the row) beside the name; the 👥 count is its own
         48dp target, not nested in the tappable name area. Left-handed
         mode moves the PTT to the start of the row at inflate. -->
    <LinearLayout
        android:id="@+id/xv_ptt_card_2"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/xv_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/xv_slot_badge_2"
            android:layout_width="24dp"
            android:layout_height="27dp"
            android:background="@drawable/xv_hex_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="2"
            android:textColor="@color/xv_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tap the name area → unified channel list. -->
        <LinearLayout
            android:id="@+id/xv_ptt_header_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="48dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/xv_ptt_channel_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:textColor="@color/xv_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Command  ▾" />

            <TextView
                android:id="@+id/xv_ptt_activity_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/xv_text_dim"
                android:textSize="12sp"
                tools:text="quiet" />
        </LinearLayout>

        <TextView
            android:id="@+id/xv_members_2"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/xv_text_dim"
            android:textSize="12sp"
            tools:text="👥 4" />

        <Button
            android:id="@+id/xv_btn_ptt2"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.9"
            android:background="@drawable/xv_ptt_bg"
            android:letterSpacing="0.2"
            android:text="PTT"
            android:textColor="@color/xv_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Channel 2 off: empty-state affordance in the same vertical slot. -->
    <TextView
        android:id="@+id/xv_btn_add_vs2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/xv_pill_off"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/xv_add_channel_2"
        android:textColor="@color/xv_text_dim"
        android:textSize="12sp" />

    <!-- Mesh-voice status line. GONE unless a multicast leg is live;
         Bluebonnet (network) normally, red "· CLEAR" when any leg is
         unencrypted. Long-press copies the live group:port. -->
    <TextView
        android:id="@+id/xv_mesh_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingStart="2dp"
        android:text="MESH READY"
        android:textColor="@color/xv_net"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
