<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel members: who is on a slot's channel right now. Opened from the
  small "👥 N" count on a main-panel row, so normally one column is shown
  (the other is hidden at runtime and the live one takes the full width);
  both columns appear when both slots are requested. Rows are built by
  XvDropDownReceiver.populateMembersColumn: tap a member to find them on
  the map, long-press to move a slot to their channel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/xv_picker_back"
            style="@style/XV.BackButton" />

        <TextView
            android:id="@+id/xv_picker_title"
            style="@style/XV.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Channel members" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/xv_members_col_ch1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/xv_members_header_ch1"
                style="@style/XV.SectionHeader"
                android:layout_marginTop="8dp"
                android:paddingBottom="6dp"
                android:text="Channel 1" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/xv_members_list_ch1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/xv_members_col_ch2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/xv_members_header_ch2"
                style="@style/XV.SectionHeader"
                android:layout_marginTop="8dp"
                android:paddingBottom="6dp"
                android:text="Channel 2" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/xv_members_list_ch2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
