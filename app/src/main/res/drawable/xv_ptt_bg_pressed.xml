<?xml version="1.0" encoding="utf-8"?>
<!-- On-screen PTT held but not yet on the air (Telecom / priming / talk-
     permit tone): neutral raised grey with the Honey outline. Red only
     once the service confirms TX (xv_ptt_bg_tx). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/xv_surface_alt"/>
    <stroke android:width="1.5dp" android:color="@color/xv_voice"/>
    <corners android:radius="8dp"/>
</shape>
