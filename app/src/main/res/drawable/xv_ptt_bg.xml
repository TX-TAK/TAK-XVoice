<?xml version="1.0" encoding="utf-8"?>
<!-- On-screen PTT button: Honey outline on Hive Black at rest; Texas Red
     while the finger is down (the receiver also flips isPressed by hand
     so this fires before the TX edge lands). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/xv_ptt_active"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/xv_bg"/>
            <stroke android:width="1.5dp" android:color="@color/xv_voice"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
