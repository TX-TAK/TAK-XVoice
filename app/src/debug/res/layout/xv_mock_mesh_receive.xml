<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP - Join with a guest pass (receiver), proposed. Preview-only.

  Reached from Mesh > Add channel and from the channel list. Two live
  methods here; Quick Share needs no screen (the guest just opens the
  received file and XV jumps to Join).
  State shown: Tap phones, listening.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="16sp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Join with a guest pass"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="Tap phones"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on" />

            <TextView
                android:layout_width="0dp"
                android:text="Scan QR"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/xv_mock_nfc_tap"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hold this phone back to back with the sender's"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Listening for a tap…"
                android:textColor="@color/xv_brand_bluebonnet"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:layout_marginTop="10dp"
            android:padding="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/xv_mock_ic_share"
                android:tint="@color/xv_brand_signal_grey" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Got a pass by Quick Share? Just open the file and XV takes you to Join."
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:layout_weight="1"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
