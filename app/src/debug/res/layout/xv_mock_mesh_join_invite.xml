<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP - Guest: after scanning an invitation QR, proposed.

  Shows the 6-digit code to read to the sender and waits for their
  approval. No words to type: the live exchange plus the matching code
  is what proves this is the right pair of phones.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Join channel"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:padding="14dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALPHA"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Invitation from Bravo-2 · signed by their TAK certificate"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="READ THIS CODE TO BRAVO-2"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:layout_marginTop="16dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="418 207"
                android:textColor="@color/xv_brand_honey"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.25"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Waiting for Bravo-2 to approve…"
                android:textColor="@color/xv_brand_bluebonnet"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WHEN APPROVED"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:background="@drawable/xv_mock_pill_on"
                android:text="Join on 1"
                android:textAllCaps="false"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_weight="1" />

            <Button
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:background="@drawable/xv_mock_button_bg"
                android:text="Join on 2"
                android:textAllCaps="false"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</ScrollView>
