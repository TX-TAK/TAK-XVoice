<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP — Share channel, proposed. Preview-only (debug source set).

  Opened from "Share" on a channel in the channel list. XV picks the
  method from who you pick:
    - Teammates on your TAK server: a direct share (no passphrase);
      the key reaches them automatically via their TAK certificate.
      The share now carries the full channel settings, not just the name.
    - Anyone else: a guest pass (next screen). Fixed address, so a
      guest on a different server can't land on the wrong group; always
      expires; listed under Guests so it can be revoked.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="16sp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Share ALPHA"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="Teammates"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on" />

            <TextView
                android:layout_width="0dp"
                android:text="Guest pass"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ON TAK.EXAMPLE"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="27dp"
                android:text="✓"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/xv_mock_hex_honey" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bravo-2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="XV · online"
                    android:textColor="@color/xv_brand_signal_grey"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="27dp"
                android:text="✓"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/xv_mock_hex_honey" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Charlie-1"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="XV · online"
                    android:textColor="@color/xv_brand_signal_grey"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="27dp"
                android:text=""
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/xv_mock_hex_outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Delta-4"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="XV · seen 12 min ago"
                    android:textColor="@color/xv_brand_signal_grey"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teammates get a Join prompt. The key follows automatically."
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/xv_mock_pill_on"
            android:text="Send to 2 teammates"
            android:textAllCaps="false"
            android:textColor="@color/xv_brand_hive_black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>
