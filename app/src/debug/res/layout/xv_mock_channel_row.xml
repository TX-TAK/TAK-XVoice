<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP — one row of the unified channel list (proposed list item).
  Preview-only (debug source set).

  Row anatomy:  [name + meta]  ............  [ 1 ] [ 2 ]
    - Filled gold pill  = this channel is on that slot.
    - Outline pill      = tap to put this channel on that slot. If the
                          channel already holds the OTHER slot, the tap
                          swaps the two slots (no teardown).
    - Tapping a filled [2] clears slot 2 (replaces the "(none)" entry).
    - No-access channels show grey, non-tappable pills.
  Mesh options move from the per-row gear icon to long-press.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    tools:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/xv_mock_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="ALPHA" />

        <TextView
            android:id="@+id/xv_mock_row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="12sp"
            tools:text="4 users · Bravo-2 talking" />
    </LinearLayout>

    <TextView
        android:id="@+id/xv_mock_row_pill_1"
        android:layout_width="44dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="1"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:background="@drawable/xv_mock_pill_on"
        tools:textColor="@color/xv_brand_hive_black" />

    <TextView
        android:id="@+id/xv_mock_row_pill_2"
        android:layout_width="44dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="2"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:background="@drawable/xv_mock_pill_off"
        tools:textColor="@color/xv_brand_wax_white" />
</LinearLayout>
