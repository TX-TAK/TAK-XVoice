<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP — on-map PTT overlay (Phase 3). Preview-only (debug source set).

  The real implementation would be ATAK MapWidgets docked via
  RootLayoutWidget (RIGHT_EDGE / LEFT_EDGE / off, operator setting) so
  ATAK's own collision avoidance keeps it clear of the compass, scale
  bar, and open panes. This Android-view mockup only shows placement,
  size and states; the green-tinted background stands in for the map.

  States shown: slot 1 receiving (speaker pill above it), slot 2
  transmitting (red). Touch targets are 72dp so they work with gloves.
  Slide-off / pane-open must release TX — a stuck key here is the
  worst failure this plugin can have.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xv_mock_map">

    <!-- Stand-ins for ATAK chrome, so spacing is judged in context. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#E6000000"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:text="ATAK toolbar (placeholder)"
        android:textColor="#80FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="+\nself marker"
        android:gravity="center"
        android:textColor="#80FFFFFF"
        android:textSize="14sp" />

    <!-- Annotation (not part of the design) -->
    <TextView
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="@drawable/xv_mock_note_bg"
        android:padding="8dp"
        android:text="MOCKUP NOTE\nRight-edge dock. Setting: Right / Left / Off.\nPTT works without opening the XV panel."
        android:textColor="@color/xv_brand_honey"
        android:textSize="11sp" />

    <!-- The HUD stack -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Speaker pill: who is talking, on which slot -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/xv_mock_hud_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="18dp"
                android:layout_height="20dp"
                android:background="@drawable/xv_mock_hex_honey"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Bravo-2"
                android:textColor="@color/xv_brand_honey"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PTT 1 (idle, receiving) -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="82dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/xv_mock_hex_ptt"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/xv_brand_honey"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center"
                android:singleLine="true"
                android:text="ALPHA"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="10sp" />
        </LinearLayout>


        <!-- PTT 2 (transmitting) -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="82dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/xv_mock_hex_ptt_tx"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center"
                android:singleLine="true"
                android:text="TX"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
