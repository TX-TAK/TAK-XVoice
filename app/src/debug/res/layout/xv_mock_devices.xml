<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP — Settings › Devices, proposed. Preview-only (debug source set).

  Replaces the two Spinners + long explanatory paragraphs with one card
  per connected input, each stating its role and exactly which button
  keys which slot. Rare recovery tools (rescan, bond repair, forget)
  collapse under "Troubleshooting". Device names are examples only.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Devices"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="What keys the radio, and on which slot."
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="13sp" />

        <!-- Card: speaker-mic -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/xv_mock_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/xv_mock_ic_radio"
                    android:tint="@color/xv_brand_honey"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AINA PTT Voice Responder V2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/xv_mock_chip"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="SPEAKER-MIC"
                    android:textColor="@color/xv_brand_honey"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="34dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/xv_mock_dot_ok" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connected · audio + buttons"
                    android:textColor="@color/xv_brand_bluebonnet"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Button map -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:paddingStart="34dp"
                android:text="PTT 1      →  channel 1\nPTT 2      →  channel 2\n             (channel 1 when 2 is off)\nEmergency  →  ATAK alert\nFixed mapping · swap channels to change"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:text="Change"
                    android:textAllCaps="false"
                    android:textColor="@color/xv_brand_honey"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card: phone hardware key (Samsung Active Key, PR #141) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/xv_mock_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_xv_audio_earpiece"
                    android:tint="@color/xv_brand_honey"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phone Active key"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/xv_mock_chip_ok"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="ASSIGNED"
                    android:textColor="@color/xv_brand_bluebonnet"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:paddingStart="34dp"
                android:text="Active key  →  channel 1\nWorks with the screen locked."
                android:lineSpacingExtra="4dp"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Empty slot: button input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/xv_mock_pill_off"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+  Add a PTT button (handlebar, glove, puck)"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Collapsed troubleshooting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Troubleshooting"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rescan · Repair pairing · Forget  ▸"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
