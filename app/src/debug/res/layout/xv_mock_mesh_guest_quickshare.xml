<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP - Guest pass > Quick Share, proposed. Preview-only.

  Sends the pass as a small .xvplan file through Android's share menu
  (Quick Share, or anything else: Signal, email, USB). Quick Share works
  phone to phone with no network. XV registers as the opener for
  .xvplan files, so the guest taps the received file and lands on
  Join. A file can be copied or forwarded, so it stays locked with four
  spoken words (plus a slow key derivation, and the pass expires),
  never sent alongside the file.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="16sp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Guest pass · ALPHA"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="Teammates"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off" />

            <TextView
                android:layout_width="0dp"
                android:text="Guest pass"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOW"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="Tap phones"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off" />

            <TextView
                android:layout_width="0dp"
                android:text="Quick Share"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="QR code"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:importantForAccessibility="no"
                    android:src="@drawable/xv_mock_ic_share"
                    android:tint="@color/xv_brand_honey" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Send with Quick Share"
                        android:textColor="@color/xv_brand_wax_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Opens Android's share menu. Pick Quick Share, then the guest's phone. Works without a network."
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TELL THE GUEST"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MESA · PECAN · RIVER · BLUFF"
            android:textColor="@color/xv_brand_honey"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="They type these four words when XV opens the pass. Say them out loud; never send them with the pass."
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXPIRES"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="8 h"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off" />

            <TextView
                android:layout_width="0dp"
                android:text="24 h"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="3 days"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="5 days"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/xv_mock_pill_on"
            android:text="Send guest pass…"
            android:textAllCaps="false"
            android:textColor="@color/xv_brand_hive_black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
