<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP - Guest pass > Tap phones (NFC), proposed. Preview-only.

  Phone-to-phone NFC: this phone acts as an NFC tag (host card
  emulation); the guest's XV reads it from Mesh > Join with a guest
  pass. Two-way handshake: the guest's phone sends a one-time public
  key, this phone answers with the pass encrypted to it. The phones
  being centimetres apart is the authentication, so there is no
  passphrase and nothing to read aloud.
  Needs: NFC on both phones, this screen on and unlocked, a ~1 s hold.
  Android to Android (iPhones generally can't act as the sender).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="16sp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Guest pass · ALPHA"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="Teammates"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off" />

            <TextView
                android:layout_width="0dp"
                android:text="Guest pass"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOW"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="Tap phones"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on" />

            <TextView
                android:layout_width="0dp"
                android:text="Quick Share"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="QR code"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/xv_mock_nfc_tap"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hold the guest's phone back to back with this one"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Ready · NFC on"
                android:textColor="@color/xv_brand_bluebonnet"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On their phone: Mesh › Join with a guest pass. No passphrase needed; the tap is the handshake."
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXPIRES"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="8 h"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off" />

            <TextView
                android:layout_width="0dp"
                android:text="24 h"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="3 days"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="5 days"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/xv_mock_pill_off"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
