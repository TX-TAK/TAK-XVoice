<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP — Add mesh channel, proposed. Preview-only (debug source set).

  Three presets replace "Create a channel" / "Configure manually" /
  the inline OpenMANET patch form:
    - Private: generated name + key, nothing to type.
    - OpenMANET talkgroup: pick TG 1-5 (more under "More"); address
      and port fill in from OpenMANET's fixed scheme. Always clear —
      the red badge says so. Can also patch onto a server channel.
    - Custom: the old manual address/port form, collapsed by default.
  State shown: OpenMANET preset selected, TG 1 picked.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="16sp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Add channel"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Private channel"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Encrypted. We pick a name and key; share it with a guest pass."
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/xv_mock_card_selected"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="OpenMANET talkgroup"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLEAR"
                    android:textColor="@color/xv_brand_texas_red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/xv_mock_chip_clear"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join an OpenMANET net. No addresses to type."
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="TG 1"
                    android:textColor="@color/xv_brand_hive_black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/xv_mock_pill_on" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="TG 2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="TG 3"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="TG 4"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="TG 5"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More talkgroups (6-32) ›"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Also patch onto my server channel"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="13sp"
                    android:layout_weight="1" />

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumbTint="@color/xv_brand_signal_grey"
                    android:trackTint="@color/xv_brand_signal_grey" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="239.192.41.1 : 38801"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Custom address"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For other systems. Enter group address and port yourself."
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/xv_mock_pill_on"
            android:text="Add TG 1"
            android:textAllCaps="false"
            android:textColor="@color/xv_brand_hive_black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
