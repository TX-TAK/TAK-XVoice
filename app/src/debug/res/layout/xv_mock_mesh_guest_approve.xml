<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP - Sender: approve guest (after the QR scan or a network
  invite), proposed. Preview-only.

  The guest's phone has connected and the key exchange is done; both
  phones show the same 6-digit code derived from both one-time keys.
  Nothing has been sent yet. Approve sends the channel key encrypted
  to the guest's one-time key and closes the invitation. A second
  request on the same invitation (someone who photographed the QR) is
  shown as a warning, never auto-approved.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Guest wants to join"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:padding="14dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALPHA"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guest phone · Pixel 8 · on this Wi-Fi"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CODE ON THEIR PHONE SHOULD BE"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:layout_marginTop="16dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="418 207"
                android:textColor="@color/xv_brand_honey"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.25"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ask them to read it out. If it doesn't match, reject."
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:background="@drawable/xv_mock_pill_off"
                android:text="Reject"
                android:textAllCaps="false"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_weight="1" />

            <Button
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:background="@drawable/xv_mock_pill_on"
                android:text="Codes match · Approve"
                android:textAllCaps="false"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_weight="2"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invitation closes after one approval · 4:31 left"
            android:textColor="@color/xv_brand_bluebonnet"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IF SOMEONE ELSE TRIES THE SAME QR"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/xv_mock_card_bg"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠"
                android:textColor="@color/xv_brand_texas_red"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Second request on this invitation"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Different code. Someone may have copied the QR. Reject it."
                    android:textColor="@color/xv_brand_signal_grey"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
