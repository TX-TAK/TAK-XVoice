<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP - unified channel list (replaces the separate VS1 / VS2
  ExpandableListView pickers). Preview-only (debug source set).

  One searchable list; each row has [1] and [2] pills (rules in
  xv_mock_channel_row.xml). The summary bar at the top shows the
  current assignment and carries the Swap button, so the 6-tap
  "clear VS2, move VS1, re-add VS2" dance becomes one tap.
  Subchannels are indented under their parent instead of using
  expand/collapse groups. Per-row gear icons are gone; mesh options
  become a long-press action.

  Slot rules: channel 1 is never blank (its lit pill cannot be
  tapped off - pick another channel to move it). Channel 2 is
  optional; tapping its lit pill clears it, and both speaker-mic PTT
  buttons then key channel 1. PTT1/PTT2 are fixed to channels 1/2;
  Swap here is the only way to "invert" them.
  State shown: slot 1 = ALPHA, slot 2 = COMMAND, mesh voice enabled.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/xv_cd_back"
            android:minWidth="48dp"
            android:text="◀"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Channels"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Current assignment + Swap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/xv_mock_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="25dp"
            android:background="@drawable/xv_mock_hex_honey"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/xv_brand_hive_black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="ALPHA"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="22dp"
            android:layout_height="25dp"
            android:background="@drawable/xv_mock_hex_honey"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/xv_brand_hive_black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="COMMAND"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/xv_mock_pill_off"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⇅ Swap"
            android:textAllCaps="false"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search -->
    <EditText
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/xv_mock_field_bg"
        android:hint="🔍  Search channels"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/xv_brand_wax_white"
        android:textColorHint="@color/xv_brand_signal_grey"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/xv_mock_ic_signal"
                android:drawablePadding="6dp"
                android:drawableTint="@color/xv_brand_signal_grey"
                android:gravity="center_vertical"
                android:letterSpacing="0.25"
                android:paddingStart="12dp"
                android:paddingBottom="4dp"
                android:text="SERVER · tak.example"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="Lobby"
                        android:textColor="@color/xv_brand_wax_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="2 users"
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="ALPHA"
                        android:textColor="@color/xv_brand_wax_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="4 users · Bravo-2 talking"
                        android:textColor="@color/xv_brand_honey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_on"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/xv_brand_hive_black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="ALPHA / Team 1"
                        android:textColor="@color/xv_brand_wax_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="1 user"
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="ALPHA / Team 2"
                        android:textColor="@color/xv_brand_wax_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="empty"
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="COMMAND"
                        android:textColor="@color/xv_brand_wax_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="7 users"
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_on"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/xv_brand_hive_black"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="LOGISTICS"
                        android:textColor="@color/xv_brand_wax_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="3 users · listen only"
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="RESTRICTED"
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="no access"
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_disabled"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/xv_brand_signal_grey"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_disabled"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/xv_brand_signal_grey"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_xv_mesh"
                android:drawablePadding="6dp"
                android:drawableTint="@color/xv_brand_signal_grey"
                android:gravity="center_vertical"
                android:letterSpacing="0.25"
                android:paddingStart="12dp"
                android:paddingBottom="4dp"
                android:text="OFFLINE · MESH"
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="Ad-hoc 1"
                        android:textColor="@color/xv_brand_wax_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="local multicast · 2 peers"
                        android:textColor="@color/xv_brand_signal_grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/xv_mock_pill_off"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/xv_brand_wax_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Tap 1 or 2 to assign. Channel 1 is always set; tap a lit 2 to turn channel 2 off.\nLong-press a channel for mesh options."
                android:textColor="@color/xv_brand_signal_grey"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
