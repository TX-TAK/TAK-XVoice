<?xml version="1.0" encoding="utf-8"?>
<!--
  UX MOCKUP - Guest pass > QR code (single-use invitation), proposed.

  The QR does NOT contain the channel key. It holds a one-time
  invitation: this phone's ephemeral public key (so the guest can't be
  fooled about who they're talking to), an invitation id, and how to
  reach this phone on the local network / mesh.
    1. Guest scans in XV; their phone connects back over the network.
    2. The phones run a key exchange; both show the same 6-digit code.
    3. You compare codes and tap Approve here; only then is the key sent,
       encrypted to the guest's one-time key.
  Single use, and the invitation dies after 5 minutes or one approval.
  A photo of the QR is useless afterwards: there is no key in it, the
  invitation is spent, and anyone racing the guest shows up as a second
  request with the wrong code. Needs both phones on the same network;
  otherwise use Quick Share (an offline pass locked with spoken words).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xv_brand_hive_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="16sp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Guest pass · ALPHA"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="Teammates"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off" />

            <TextView
                android:layout_width="0dp"
                android:text="Guest pass"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOW"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="Tap phones"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off" />

            <TextView
                android:layout_width="0dp"
                android:text="Quick Share"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="QR code"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@color/xv_brand_wax_white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR CODE"
                android:textColor="@color/xv_brand_comb"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:layout_gravity="center"
                android:layout_marginTop="52dp" />

            <ImageView
                android:layout_width="68dp"
                android:layout_height="47dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/xv_mock_brand_mark_dark" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SINGLE USE"
                android:textColor="@color/xv_brand_bluebonnet"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="0dp"
                android:background="@drawable/xv_mock_chip_ok"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPIRES IN 4:52"
                android:textColor="@color/xv_brand_honey"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:background="@drawable/xv_mock_chip"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guest scans with XV. You'll both see a 6-digit code; check they match, then approve here."
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHANNEL ACCESS LASTS"
            android:textColor="@color/xv_brand_signal_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:text="8 h"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off" />

            <TextView
                android:layout_width="0dp"
                android:text="24 h"
                android:textColor="@color/xv_brand_hive_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_on"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="3 days"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="0dp"
                android:text="5 days"
                android:textColor="@color/xv_brand_wax_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/xv_mock_pill_off"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/xv_mock_pill_off"
            android:text="Cancel invitation"
            android:textAllCaps="false"
            android:textColor="@color/xv_brand_wax_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
