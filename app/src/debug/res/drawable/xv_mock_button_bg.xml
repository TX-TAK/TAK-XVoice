<?xml version="1.0" encoding="utf-8"?>
<!-- UX mockup drawable (debug source set only; never ships in release/TPP). Brand-kit colors. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/xv_brand_texas_red"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/xv_brand_hive_black"/>
            <stroke android:width="1.5dp" android:color="@color/xv_brand_honey"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
